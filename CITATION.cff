    given-names: Zhaorui
version: 1.1.0
date-released: "2026-06-17"
license: MIT
repository-code: "https://github.com/zhaorui-bi/Ariadne"
url: "https://github.com/zhaorui-bi/Ariadne"
keywords:
  - bioinformatics
  - terpene synthase
  - coral
  - phylogenetics
  - ESM2
  - protein discovery
